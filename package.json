{
  "name": "mnemosyne-cloud-cost-demo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev:graphql": "npm run dev --workspace=graphql",
    "db:generate": "npm run db:generate --workspace=@demo/database",
    "db:migrate": "npm run db:migrate --workspace=@demo/database",
    "lint": "npm run lint --workspace=web"
  },
  "devDependencies": {
    "turbo": "^2.2.3",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "better-sqlite3@12.11.1": true
  }
}
